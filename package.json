{
  "name": "keireki-craft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "qa:pdf": "node qa/pdf-compare.cjs",
    "qa:e2e": "npm run build && node qa/e2e/run.cjs",
    "qa:security": "npm run build && node qa/security.cjs",
    "qa:roundtrip": "npm run build && node qa/roundtrip.cjs",
    "qa:consistency": "npm run build && node qa/consistency.cjs",
    "qa": "npm run build && node qa/e2e/run.cjs && node qa/security.cjs && node qa/roundtrip.cjs && node qa/consistency.cjs && node qa/pdf-compare.cjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/arimo": "5.3.0",
    "@fontsource/caladea": "5.3.0",
    "@fontsource/carlito": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/gelasio": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "idb-keyval": "^6.2.1",
    "pagedjs": "^0.4.3",
    "pdfjs-dist": "^4.7.76",
    "pdfkit": "0.20.2",
    "pinia": "^2.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.1.10"
  }
}
